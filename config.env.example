# cp config.env.example config.env して書き換える。run.sh が起動のたびに読む
# 押している間だけ録音するキー: alt_r（右 Option）/ cmd_r / ctrl_r / shift_r
export VOICE_INPUT_HOTKEY=alt_r
# 0 にすると、ローカル LLM での整形をしない（メニューで入り切りもできる）
# export VOICE_INPUT_POLISH=0
# 0 にすると、話した内容の履歴（logs/history.jsonl）を残さない
# export VOICE_INPUT_HISTORY=0
# ログの置き場（既定はこのフォルダの logs/）
# export VOICE_INPUT_LOG_DIR="$HOME/Library/Logs/VoiceInput"
